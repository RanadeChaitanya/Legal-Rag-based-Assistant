# Gemini Models Configuration
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_REASON=gemini-3.8-flash

# Qdrant Vector DB Configuration
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_v1

# Cloudflare Workers AI Embeddings (account id is part of the endpoint URL)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBED_MODEL=@cf/baai/bge-m3
EMBED_DIM=1024

# Retrieval tuning
TOP_K_DENSE=40
TOP_K_SPARSE=40
FINAL_TOP_K=8
# client = FastEmbed BM25 computed locally (works on free Qdrant tier)
# cloud  = Qdrant Cloud Inference (needs a paid cluster)
BM25_MODE=client

# System & Session Storage
SESSION_DB_PATH=./data/sessions.sqlite3
SESSION_TTL_HOURS=24
API_BASE_URL=http://127.0.0.1:8000
